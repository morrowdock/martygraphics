{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MartyGraphics core scene v1 (draft)",
  "description": "Wire structure for standalone core scenes. See scene-v1.schema-notes.md for semantic checks and limitations.",
  "type": "object",
  "properties": {
    "v": {"type":"integer","const":1},
    "template": {"type":"string"},
    "params": {"type":"object"},
    "title": {"type":"string","minLength":1,"maxLength":60},
    "dim": {"enum":["2d","3d"]},
    "world": {
      "type": "object",
      "properties": {"w":{"type":"number","minimum":2,"maximum":100},"h":{"type":"number","minimum":2,"maximum":100}},
      "required": ["w","h"],
      "additionalProperties": false
    },
    "items": {"type":"array","items":{"$ref":"#/$defs/item"},"minItems":0,"maxItems":24},
    "steps": {"type":"array","items":{"$ref":"#/$defs/step"},"minItems":1,"maxItems":8},
    "camera": {"$ref":"#/$defs/camera"},
    "hide": {"type":"array","items":{"$ref":"#/$defs/id"},"minItems":0,"maxItems":16},
    "over": {"type":"array","items":{"$ref":"#/$defs/edit"},"minItems":0,"maxItems":16},
    "alt": {"type":"string","minLength":1,"maxLength":200},
    "sliders": {"type":"array","items":{"$ref":"#/$defs/slider"},"minItems":1,"maxItems":3}
  },
  "required": ["v"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required":["template"]},
      "then": {"required":["params"],"not":{"required":["world"]},"properties":{"items":{"maxItems":10}}},
      "else": {
        "required": ["items"],
        "not": {"anyOf":[{"required":["params"]},{"required":["hide"]},{"required":["over"]}]},
        "properties": {"items":{"minItems":1}}
      }
    },
    {
      "if": {"properties":{"dim":{"const":"3d"}},"required":["dim"]},
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {"k":{"enum":["body","incline","line","vector","axes","orbit","text","highlight","path"]}},
              "not": {"required":["k","style"],"properties":{"k":{"const":"text"},"style":{"const":"code"}}}
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "at": {"maxItems":2},
                    "from": {"maxItems":2},
                    "to": {"maxItems":2},
                    "move": {"properties":{"to":{"maxItems":2}}}
                  }
                },
                {
                  "if": {"properties":{"k":{"enum":["rope","path","region"]}},"required":["k"]},
                  "then": {"properties":{"pts":{"items":{"maxItems":2}}}}
                },
                {
                  "if": {"properties":{"k":{"const":"vector"}},"required":["k"]},
                  "then": {"not":{"required":["dir"]}}
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {"required":["template"],"properties":{"template":{"const":"bst"}}},
      "then": {"properties":{"params":{"$ref":"#/$defs/bstParams"}}}
    },
    {
      "if": {"required":["template"],"properties":{"template":{"const":"two_pointers"}}},
      "then": {"properties":{"params":{"$ref":"#/$defs/twoPointersParams"}}}
    },
    {
      "if": {"required":["template"],"properties":{"template":{"const":"shortest_path"}}},
      "then": {"properties":{"params":{"$ref":"#/$defs/shortestPathParams"}}}
    }
  ],
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":24,"pattern":"^[A-Za-z][A-Za-z0-9_]*$"},
    "label": {"type":"string","minLength":1,"maxLength":40},
    "color": {
      "enum": [
        "force",
        "normal",
        "friction",
        "gravity",
        "tension",
        "velocity",
        "accel",
        "energy",
        "kinetic",
        "potential",
        "accent",
        "muted",
        "good",
        "warn",
        "blue",
        "red",
        "green",
        "orange",
        "purple",
        "yellow",
        "teal",
        "white"
      ]
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {"type":"number","minimum":-25,"maximum":125},
        {"type":"number","minimum":-25,"maximum":125},
        {"type":"number","minimum":-100,"maximum":100}
      ],
      "items": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "x": {"type":"number","minimum":0,"maximum":100},
        "y": {"type":"number","minimum":0,"maximum":100},
        "zoom": {"type":"number","minimum":0.5,"maximum":4},
        "yaw": {"type":"number","minimum":-180,"maximum":180},
        "pitch": {"type":"number","minimum":-89,"maximum":89}
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "properties": {"id":{"$ref":"#/$defs/id"},"key":{"type":"string","not":{"enum":["id","k"]}},"value":{}},
      "required": ["id","key","value"],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "say": {"type":"string","minLength":1,"maxLength":200},
        "show": {"type":"array","items":{"$ref":"#/$defs/id"},"minItems":0,"maxItems":16},
        "focus": {"$ref":"#/$defs/id"},
        "cam": {"$ref":"#/$defs/camera"},
        "do": {"type":"array","items":{"$ref":"#/$defs/edit"},"minItems":1,"maxItems":6},
        "alt": {"type":"string","minLength":1,"maxLength":200}
      },
      "required": ["say"],
      "additionalProperties": false
    },
    "slider": {
      "type": "object",
      "properties": {
        "param": {"enum":["a","b","c"]},
        "min": {"type":"number","minimum":-1000,"maximum":1000},
        "max": {"type":"number","minimum":-1000,"maximum":1000},
        "step": {"type":"number","exclusiveMinimum":0,"maximum":2000},
        "default": {"type":"number","minimum":-1000,"maximum":1000},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["param","min","max","step","default","label"],
      "additionalProperties": false
    },
    "item": {
      "oneOf": [
        {"$ref":"#/$defs/body"},
        {"$ref":"#/$defs/incline"},
        {"$ref":"#/$defs/line"},
        {"$ref":"#/$defs/vector"},
        {"$ref":"#/$defs/axes"},
        {"$ref":"#/$defs/plot"},
        {"$ref":"#/$defs/spring"},
        {"$ref":"#/$defs/pulley"},
        {"$ref":"#/$defs/rope"},
        {"$ref":"#/$defs/orbit"},
        {"$ref":"#/$defs/text"},
        {"$ref":"#/$defs/highlight"},
        {"$ref":"#/$defs/bars"},
        {"$ref":"#/$defs/path"},
        {"$ref":"#/$defs/array"},
        {"$ref":"#/$defs/node"},
        {"$ref":"#/$defs/edge"},
        {"$ref":"#/$defs/table"},
        {"$ref":"#/$defs/region"},
        {"$ref":"#/$defs/func"},
        {"$ref":"#/$defs/field"},
        {"$ref":"#/$defs/curve"}
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"body"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "shape": {"enum":["box","ball"]},
        "size": {"type":"number","minimum":0.1,"maximum":50},
        "angle": {"type":"number","minimum":-360,"maximum":360},
        "label": {"$ref":"#/$defs/label"},
        "move": {
          "type": "object",
          "properties": {"to":{"$ref":"#/$defs/point"},"t":{"type":"number","minimum":0.3,"maximum":10}},
          "required": ["to","t"],
          "additionalProperties": false
        }
      },
      "required": ["id","k","at"],
      "additionalProperties": false
    },
    "incline": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"incline"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "base": {"type":"number","minimum":0.5,"maximum":125},
        "angle": {"type":"number","minimum":0,"maximum":80},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","base","angle"],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"line"},
        "color": {"$ref":"#/$defs/color"},
        "from": {"$ref":"#/$defs/point"},
        "to": {"$ref":"#/$defs/point"},
        "style": {"enum":["solid","dashed","ground"]}
      },
      "required": ["id","k","from","to"],
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"vector"},
        "color": {"$ref":"#/$defs/color"},
        "from": {"$ref":"#/$defs/point"},
        "on": {"$ref":"#/$defs/id"},
        "angle": {"type":"number","minimum":-360,"maximum":360},
        "dir": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1,"maximum":1},
            {"type":"number","minimum":-1,"maximum":1},
            {"type":"number","minimum":-1,"maximum":1}
          ],
          "minItems": 3,
          "items": false
        },
        "len": {"type":"number","minimum":0,"maximum":100},
        "label": {"$ref":"#/$defs/label"},
        "dashed": {"type":"boolean"}
      },
      "required": ["id","k","len"],
      "additionalProperties": false,
      "allOf": [
        {"oneOf":[{"required":["from"]},{"required":["on"]}]},
        {"oneOf":[{"required":["angle"]},{"required":["dir"]}]}
      ]
    },
    "axes": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"axes"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "xl": {"$ref":"#/$defs/label"},
        "yl": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","w","h"],
      "additionalProperties": false
    },
    "plot": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"plot"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "xr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "yr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "pts": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type":"number","minimum":-1000000,"maximum":1000000},
              {"type":"number","minimum":-1000000,"maximum":1000000}
            ],
            "minItems": 2,
            "items": false
          },
          "minItems": 2,
          "maxItems": 64
        },
        "xl": {"$ref":"#/$defs/label"},
        "yl": {"$ref":"#/$defs/label"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","w","h","xr","yr","pts"],
      "additionalProperties": false
    },
    "spring": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"spring"},
        "color": {"$ref":"#/$defs/color"},
        "from": {"$ref":"#/$defs/point"},
        "to": {"$ref":"#/$defs/point"},
        "coils": {"type":"integer","minimum":3,"maximum":24},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","from","to"],
      "additionalProperties": false
    },
    "pulley": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"pulley"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "r": {"type":"number","minimum":0.05,"maximum":25}
      },
      "required": ["id","k","at","r"],
      "additionalProperties": false
    },
    "rope": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"rope"},
        "color": {"$ref":"#/$defs/color"},
        "pts": {"type":"array","items":{"$ref":"#/$defs/point"},"minItems":2,"maxItems":6}
      },
      "required": ["id","k","pts"],
      "additionalProperties": false
    },
    "orbit": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"orbit"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "r": {"type":"number","minimum":0.1,"maximum":50},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","r"],
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"text"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "text": {"type":"string","minLength":1,"maxLength":120},
        "style": {"enum":["label","callout","title","code"]}
      },
      "required": ["id","k","at","text"],
      "additionalProperties": false
    },
    "highlight": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"highlight"},
        "color": {"$ref":"#/$defs/color"},
        "target": {"$ref":"#/$defs/id"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","target"],
      "additionalProperties": false
    },
    "bars": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"bars"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "bars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {"type":"string","minLength":1,"maxLength":16},
              "value": {"type":"number","minimum":-10000000,"maximum":10000000},
              "color": {"$ref":"#/$defs/color"}
            },
            "required": ["label","value"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 6
        },
        "unit": {"type":"string","minLength":1,"maxLength":8},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","w","h","bars"],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"path"},
        "color": {"$ref":"#/$defs/color"},
        "pts": {"type":"array","items":{"$ref":"#/$defs/point"},"minItems":2,"maxItems":64},
        "dashed": {"type":"boolean"}
      },
      "required": ["id","k","pts"],
      "additionalProperties": false
    },
    "array": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"array"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "vals": {
          "type": "array",
          "items": {
            "anyOf": [
              {"type":"string","minLength":1,"maxLength":6},
              {"type":"number","exclusiveMinimum":-1000000,"exclusiveMaximum":1000000}
            ]
          },
          "minItems": 1,
          "maxItems": 16
        },
        "cell": {"type":"number","minimum":0.3,"maximum":25},
        "ptrs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "i": {"type":"integer","minimum":0,"maximum":15},
              "label": {"type":"string","minLength":1,"maxLength":8}
            },
            "required": ["i","label"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 4
        },
        "marked": {"type":"array","items":{"type":"integer","minimum":0,"maximum":15},"minItems":0,"maxItems":16},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","vals"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"node"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "text": {"type":"string","minLength":1,"maxLength":8},
        "r": {"type":"number","minimum":0.2,"maximum":16.666666666666668}
      },
      "required": ["id","k","at","text"],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"edge"},
        "color": {"$ref":"#/$defs/color"},
        "a": {"$ref":"#/$defs/id"},
        "b": {"$ref":"#/$defs/id"},
        "dir": {"type":"boolean"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","a","b"],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"table"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {"type":"string","minLength":0,"maxLength":12},
                {"type":"number","exclusiveMinimum":-1000000,"exclusiveMaximum":1000000}
              ]
            },
            "minItems": 1,
            "maxItems": 6
          },
          "minItems": 1,
          "maxItems": 8
        },
        "header": {"type":"boolean"},
        "cw": {"type":"number","minimum":0.3,"maximum":33.333333333333336},
        "rh": {"type":"number","minimum":0.3,"maximum":16.666666666666668},
        "marked": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{"type":"integer","minimum":0,"maximum":7},{"type":"integer","minimum":0,"maximum":5}],
            "minItems": 2,
            "items": false
          },
          "minItems": 0,
          "maxItems": 48
        },
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","cells"],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"region"},
        "color": {"$ref":"#/$defs/color"},
        "pts": {"type":"array","items":{"$ref":"#/$defs/point"},"minItems":3,"maxItems":64},
        "dashed": {"type":"boolean"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","pts"],
      "additionalProperties": false
    },
    "func": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"func"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "xr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "yr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "y": {"type":"string","minLength":1,"maxLength":80},
        "a": {"type":"number","minimum":-1000,"maximum":1000},
        "b": {"type":"number","minimum":-1000,"maximum":1000},
        "c": {"type":"number","minimum":-1000,"maximum":1000},
        "period": {"type":"number","minimum":0.5,"maximum":20},
        "shade": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "mark": {"type":"number","minimum":-1000000,"maximum":1000000},
        "readouts": {"type":"array","items":{"enum":["value","slope","area"]},"minItems":1,"maxItems":3},
        "xl": {"$ref":"#/$defs/label"},
        "yl": {"$ref":"#/$defs/label"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","w","h","xr","yr","y"],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"field"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "xr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "yr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "dx": {"type":"string","minLength":1,"maxLength":80},
        "dy": {"type":"string","minLength":1,"maxLength":80},
        "a": {"type":"number","minimum":-1000,"maximum":1000},
        "b": {"type":"number","minimum":-1000,"maximum":1000},
        "c": {"type":"number","minimum":-1000,"maximum":1000},
        "n": {
          "type": "array",
          "prefixItems": [{"type":"integer","minimum":2,"maximum":16},{"type":"integer","minimum":2,"maximum":12}],
          "minItems": 2,
          "items": false
        },
        "style": {"enum":["arrows","unit","slope"]},
        "xl": {"$ref":"#/$defs/label"},
        "yl": {"$ref":"#/$defs/label"},
        "label": {"$ref":"#/$defs/label"}
      },
      "required": ["id","k","at","w","h","xr","yr","dx","dy"],
      "additionalProperties": false
    },
    "curve": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "k": {"const":"curve"},
        "color": {"$ref":"#/$defs/color"},
        "at": {"$ref":"#/$defs/point"},
        "w": {"type":"number","minimum":0.5,"maximum":125},
        "h": {"type":"number","minimum":0.5,"maximum":125},
        "xr": {
          "type": "array",
          "prefixItems": [
            {"type":"number","minimum":-1000000,"maximum":1000000},
            {"type":"number","minimum":-1000000,"maximum":1000000}
          ],
          "minItems": 2,
          "items": false
        },
        "yr": {
          "type": "array",
