{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MartyGraphics ML explainer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "kind",
    "title",
    "items"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "ml-explainer"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/visionPipeline"
          },
          {
            "$ref": "#/$defs/nextTokenProbabilities"
          },
          {
            "$ref": "#/$defs/agentLoop"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "visionPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "caption",
        "imageSize",
        "patchSize",
        "embeddingWidth",
        "textTokens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "visionPipeline"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "imageSize": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "minItems": 2,
          "maxItems": 2
        },
        "patchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "embeddingWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "embeddingWidthCitation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "projectorLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "languageModelLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "textTokens": {
          "$ref": "#/$defs/tokens"
        }
      }
    },
    "nextTokenProbabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "tokens",
        "candidates",
        "chosen"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "nextTokenProbabilities"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "logit"
            ],
            "properties": {
              "token": {
                "$ref": "#/$defs/token"
              },
              "logit": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          "minItems": 2,
          "maxItems": 8
        },
        "chosen": {
          "$ref": "#/$defs/token"
        },
        "temperature": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "topP": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "agentLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "states",
        "requiresReview",
        "stepBudget"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "agentLoop"
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "plan",
              "toolCall",
              "toolResult",
              "review",
              "act",
              "revise",
              "stop"
            ]
          },
          "minItems": 5,
          "maxItems": 7,
          "uniqueItems": true
        },
        "requiresReview": {
          "type": "boolean"
        },
        "stepBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  }
}
