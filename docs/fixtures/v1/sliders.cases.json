    {"name": "a label over 40 characters", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}, "reason": "slider.label"},
    {"name": "a blank label", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "  "}]}, "reason": "slider.label"},
