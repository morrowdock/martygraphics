    {"name": "a field sets a", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}, {"id": "v", "k": "field", "at": [1, 1], "w": 4, "h": 4, "xr": [-2, 2], "yr": [-2, 2], "dx": "a", "dy": "x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.field"},
