{
  "about": "Golden cases for the scene `sliders` key (docs/PROTOCOL.md, \"Learner sliders\"). Checked by Tests/MartyGraphicsTests/SliderTests.swift (MGParser, authoritative) and by tools/tests/test_mg_expr.py and tools/tests/test_scene_v1_schema.py (the offline mirror and the draft preflight). An accepted scene lists each slider's parameter, its number of steps, the grid position of its default and the func items it drives. A refused scene lists the parser's reason.",
  "accepted": [
    {"name": "three sliders on one wave", "scene": {"v": 1, "items": [{"id": "wave", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3.2, 3.2], "yr": [-4, 4], "y": "a*sin(b*x)+c", "a": 1, "b": 1, "c": 0, "mark": 1.5708, "label": "y = a sin(bx) + c"}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.25, "default": 1, "label": "Height a"}, {"param": "b", "min": 0.5, "max": 3, "step": 0.5, "default": 1, "label": "Frequency b"}, {"param": "c", "min": -1, "max": 1, "step": 0.5, "default": 0, "label": "Shift c"}]}, "sliders": [{"param": "a", "steps": 8, "defaultStop": 4, "items": ["wave"]}, {"param": "b", "steps": 5, "defaultStop": 1, "items": ["wave"]}, {"param": "c", "steps": 4, "defaultStop": 2, "items": ["wave"]}]},
    {"name": "tenths: 3 / 0.1 is a whole number of steps", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 3, "step": 0.1, "default": 1, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 30, "defaultStop": 10, "items": ["f"]}]},
    {"name": "exactly 100 steps", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 10, "step": 0.1, "default": 1, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 100, "defaultStop": 10, "items": ["f"]}]},
    {"name": "one step across the whole range", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 1, "step": 1, "default": 1, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 1, "defaultStop": 1, "items": ["f"]}]},
    {"name": "a negative range with the default at min", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": -3}], "sliders": [{"param": "a", "min": -3, "max": -1, "step": 0.5, "default": -3, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 4, "defaultStop": 0, "items": ["f"]}]},
    {"name": "one slider drives two graphs", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}, {"id": "g", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 4, "defaultStop": 2, "items": ["f", "g"]}]},
    {"name": "a graph that does not set the parameter is not driven", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}, {"id": "g", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "x"}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "sliders": [{"param": "a", "steps": 4, "defaultStop": 2, "items": ["f"]}]}
  ],
  "refused": [
    {"name": "sliders is not a list", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": {}}, "reason": "sliders"},
    {"name": "no sliders", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": []}, "reason": "sliders"},
    {"name": "four sliders", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}, {"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}, {"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}, {"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "sliders"},
    {"name": "a slider is not an object", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [1]}, "reason": "slider"},
    {"name": "a slider without a label", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1}]}, "reason": "slider.missing"},
    {"name": "an unknown slider key", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a", "unit": "m"}]}, "reason": "slider.unknown.unit"},
    {"name": "param x", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "x", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.param"},
    {"name": "param t", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "t", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.param"},
    {"name": "param is not text", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": 1, "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.param"},
    {"name": "two sliders for a", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}, {"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Again"}]}, "reason": "slider.duplicate.a"},
    {"name": "min beyond the parameter bound", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": -1001, "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.min"},
    {"name": "max beyond the parameter bound", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 1000.5, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.max"},
    {"name": "min is not text", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": "0", "max": 2, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.min"},
    {"name": "min equals max", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 1, "max": 1, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.range"},
    {"name": "min above max", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 2, "max": 0, "step": 0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.range"},
    {"name": "step zero", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0, "default": 1, "label": "Slope a"}]}, "reason": "slider.step"},
    {"name": "step negative", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": -0.5, "default": 1, "label": "Slope a"}]}, "reason": "slider.step"},
    {"name": "step wider than the range", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 3, "default": 1, "label": "Slope a"}]}, "reason": "slider.step"},
    {"name": "step does not divide the range", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.3, "default": 1, "label": "Slope a"}]}, "reason": "slider.step"},
    {"name": "200 steps", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.01, "default": 1, "label": "Slope a"}]}, "reason": "slider.step.count"},
    {"name": "101 steps", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 10.1, "step": 0.1, "default": 1, "label": "Slope a"}]}, "reason": "slider.step.count"},
    {"name": "stops closer than the doubles near 1", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 1, "max": 1.0000000000000004, "step": 1.1102230246251565e-16, "default": 1, "label": "Slope a"}]}, "reason": "slider.grid"},
