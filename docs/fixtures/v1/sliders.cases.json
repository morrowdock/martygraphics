    {"name": "default outside the range", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 3, "label": "Slope a"}]}, "reason": "slider.default"},
    {"name": "a default near a stop of 0 but not 0", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1e-12}], "sliders": [{"param": "a", "min": -1, "max": 1, "step": 1, "default": 1e-12, "label": "Slope a"}]}, "reason": "slider.default"},
    {"name": "max is shown as 1 but is 1.0000000002", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "0.0000000001/(a-1)", "a": 0}], "sliders": [{"param": "a", "min": 0, "max": 1.0000000002, "step": 1, "default": 0, "label": "Shift a"}]}, "reason": "slider.grid"},
    {"name": "a default shown as max does not replace max", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 1.0000000002, "step": 1, "default": 1, "label": "Slope a"}]}, "reason": "slider.grid"},
    {"name": "a default shown as a stop but not exactly its value", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 0.30000000000000004}], "sliders": [{"param": "a", "min": 0, "max": 1, "step": 0.1, "default": 0.30000000000000004, "label": "Slope a"}]}, "reason": "slider.default"},
    {"name": "a placeholder in the label", "scene": {"v": 1, "items": [{"id": "f", "k": "func", "at": [1, 1], "w": 10, "h": 6, "xr": [-3, 3], "yr": [-4, 4], "y": "a*x", "a": 1}], "sliders": [{"param": "a", "min": 0, "max": 2, "step": 0.5, "default": 1, "label": "Slope {a}"}]}, "reason": "slider.label.placeholder"},
