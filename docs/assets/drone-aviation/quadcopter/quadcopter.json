 "steps": [
  {"say": "This quadcopter has four motors on a rigid frame. Each motor turns one propeller with fixed blades.", "camera": "backLeft", "spin": 2},
  {"say": "The battery feeds four speed controllers (ESCs). The flight controller tells each ESC how fast to turn its motor.", "camera": "backLeft",
   "focus": ["battery", "fc", "gps", "escs"], "annotate": ["lEsc", "lBatt", "lFc", "lGps"]},
  {"say": "Seen from above: M1 and M2 turn counter-clockwise, M3 and M4 turn clockwise. Each pair sits on one diagonal.", "camera": "top", "spin": 2,
   "annotate": ["lM1", "lM2", "lM3", "lM4", "lFront", "t1", "t2", "t3", "t4"],
   "check": [{"value": "prop1.speed", "gt": 0}, {"value": "prop2.speed", "gt": 0}, {"value": "prop3.speed", "lt": 0}, {"value": "prop4.speed", "lt": 0}]},
  {"say": "A motor turns its propeller one way. Each motor applies an opposite reaction torque to the frame. The clockwise and counter-clockwise reaction torques cancel when their totals are equal.", "camera": "backLeft", "spin": 2,
   "focus": ["prop1", "bell1"], "annotate": ["t1", "lTwist"]},
  {"say": "In a steady, level hover in still air, total thrust balances weight and the torques balance. The drone has no vertical acceleration or change in its turn rate. The arrows are schematic.", "camera": "low", "orbit": 111, "spin": 2,
   "annotate": ["f1", "f2", "f3", "f4", "w"]},
  {"say": "Roll: the left motors speed up and the right motors slow down. The left side rises, so the frame rolls to the right.", "camera": "front", "spin": 2,
   "pose": {"frame": {"rot": [0, 1, 0, 18]}}, "annotate": ["b2", "b3", "s1", "s4", "w"]},
  {"say": "Now the thrust is tilted. Its sideways part pushes the drone to the right.", "camera": "front", "spin": 2,
   "pose": {"frame": {"rot": [0, 1, 0, 18]}}, "annotate": ["f1", "f2", "f3", "f4", "side", "w"]},
  {"say": "Pitch works the same way: the rear motors speed up and the front motors slow down. The nose goes down, and the forward part of the thrust moves the drone forward.", "camera": "side", "spin": 2,
   "pose": {"frame": {"rot": [-1, 0, 0, 18]}}, "annotate": ["b2", "b4", "s1", "s3", "fwd", "w"]},
  {"say": "For a clockwise yaw turn, seen from above, the controller increases thrust from M1 and M2 and reduces thrust from M3 and M4. It can select these changes to keep total thrust nearly constant. The reaction torques no longer balance.", "camera": "backLeft", "spin": 2,
   "pose": {"frame": {"rot": [0, 0, -1, 40]}}, "annotate": ["b1", "b2", "s3", "s4"],
   "check": [{"value": "prop1.speed", "gt": 0}, {"value": "prop2.speed", "gt": 0}, {"value": "prop3.speed", "lt": 0}, {"value": "prop4.speed", "lt": 0}]},
  {"say": "The engine checked the turn direction of each propeller and the weight direction. The weight arrow starts at the volume centre of all drawn parts, ground marking included. This is not the aircraft CG. Arrows and tilts are authored.", "camera": "backLeft", "spin": 2}
 ]}
