 "steps": [
  {"say": "A brushless outrunner motor. The outer shell, called the bell, turns with the propeller. The middle part is fixed to the drone.", "camera": "hero", "spin": 1,
   "focus": ["bell", "base", "leads", "shaft"], "annotate": ["lBell", "tBell", "lWires"]},
  {"say": "Cut the bell open. Permanent magnets line the inside of the bell. The fixed stator in the middle carries coils of copper wire.", "camera": "hero",
   "focus": ["bell", "base", "leads", "shaft"], "section": {"normal": [1, -1, 0], "offset": 0, "parts": ["bell"]}, "hide": ["magN1", "magN6", "magN7", "magS1", "magS5", "magS6", "magS7"],
   "annotate": ["lMag", "lCoil", "lStator"]},
  {"say": "The parts, pulled apart along the shaft. Two bearings hold the shaft, so the bell turns freely round the stator.", "camera": "hero", "explode": 1,
   "focus": ["bell", "base", "shaft", "stator"], "section": {"normal": [1, -1, 0], "offset": 0, "parts": ["bell"]}, "hide": ["magN1", "magN6", "magN7", "magS1", "magS5", "magS6", "magS7"],
   "annotate": ["lBell", "lMag", "lShaft", "lStator", "lCoil", "lBearing"]},
  {"say": "This stator has {count.coil} coils, one on each tooth. The bell has {count.magN} magnets with the north pole facing in and {count.magS} with the south pole facing in. They alternate round the ring.", "camera": "top",
   "focus": ["base"], "hide": ["bell"]},
  {"say": "The coils are joined in three groups, called phases. This is phase A: two pairs of neighbouring coils on opposite sides. In each pair, the two coils are wound in opposite directions.", "camera": "top",
   "focus": ["base"], "hide": ["bell"], "highlight": ["coil1", "coil2", "coil7", "coil8"], "annotate": ["lA"]},
  {"say": "Phase B is the next two pairs.", "camera": "top", "focus": ["base"], "hide": ["bell"], "highlight": ["coil3", "coil4", "coil9", "coil10"], "annotate": ["lB"]},
  {"say": "Phase C is the last two pairs. Current in a phase makes its coils electromagnets. In each pair, one coil face is north and one is south. They pull unlike magnet poles and push like poles.", "camera": "top",
   "focus": ["base"], "hide": ["bell"], "highlight": ["coil5", "coil6", "coil11", "coil12"], "annotate": ["lC"]},
  {"say": "In six-step control, the speed controller energizes two phases at a time and changes the pair in a repeating order. The stator's magnetic field turns, and the magnets follow it.", "camera": "hero", "spin": 1,
   "focus": ["bell", "base", "leads", "shaft"], "section": {"normal": [1, -1, 0], "offset": 0, "parts": ["bell"]}, "hide": ["magN1", "magN6", "magN7", "magS1", "magS5", "magS6", "magS7"], "annotate": ["tBell"]},
  {"say": "Seen from above without the bell: the ring of magnets turns round the fixed coils. One turn of the bell takes {count.magN} electrical cycles, one for each pair of magnets.", "camera": "top", "spin": 1,
   "focus": ["base"], "hide": ["bell"]},
  {"say": "Swap any two of the three wires and the order reverses: the motor turns the other way.", "camera": "top", "spin": -1,
   "focus": ["base", "leads"], "annotate": ["tBack", "lWires"]},
  {"say": "What the engine checked: the turning of the bell, and the counts of coils and magnets. Currents, magnetic forces and torque are not computed.", "camera": "hero", "spin": 1,
   "focus": ["bell", "base", "leads", "shaft"], "section": {"normal": [1, -1, 0], "offset": 0, "parts": ["bell"]}, "hide": ["magN1", "magN6", "magN7", "magS1", "magS5", "magS6", "magS7"]}
 ]}
