   "joint": {"revolute": [0, 0, 1]}, "expect": {"axisWorld": [0, 1, 0]}}
 ],
 "constraints": [{"gearMesh": {"a": "input", "b": "idler"}}, {"gearMesh": {"a": "idler", "b": "output"}}],
