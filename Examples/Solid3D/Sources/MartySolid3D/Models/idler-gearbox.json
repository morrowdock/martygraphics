  {"say": "The output turns the same way as the input, {output.speed|frac} of a turn per input turn.", "camera": "front",
   "highlight": ["output"], "spin": 1, "section": {"normal": [0, -1, 0], "parts": ["casing"]},
   "check": [{"value": "output.speed", "eq": 0.5714285714285714, "tol": 1e-9}]},
  {"say": "The idler's size cancels out: the ratio is input teeth over output teeth, {input.teeth} to {output.teeth}.",
